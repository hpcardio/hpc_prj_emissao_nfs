# Portal ISS Fortaleza
PORTAL_PREFEITURA_FORTALEZA=https://iss.fortaleza.ce.gov.br/grpfor/home.seam
CPF_LOGIN=00000000000
# Use aspas simples quando a senha contiver $, por exemplo: 'senha$literal'
SENHA='altere-me'
NFSE_ISSUER_CNPJ=59932105000121
NFSE_DEFAULT_CITY=FORTALEZA
NFSE_DEFAULT_UF=CE

# PostgreSQL compartilhado com api_prontocardio
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
POSTGRES_SCHEMA=api_prontocardio
NFSE_POSTGRES_CONN_ID=postgres_prontocardio
AIRFLOW_CONN_POSTGRES_PRONTOCARDIO=postgresql://usuario:senha@host:5432/banco

# Airflow/Astro
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
NFSE_EXTRACTION_SCHEDULE=*/15 * * * *
NFSE_DOWNLOADS_DIR=/usr/local/airflow/data/nfse
NFSE_ARTIFACTS_DIR=/usr/local/airflow/data/artifacts

# Portal Credenciado IPM Saude
IPM_PORTAL_URL=https://ipmsaude.topsaudehub.com.br/PortalCredenciado
IPM_LOGIN=LOGIN_DO_PRESTADOR
IPM_PASSWORD='SENHA_DO_PORTAL'
IPM_PROVIDER_CODE=CODIGO_DO_PRESTADOR
IPM_OPERATOR_CODE=1
IPM_POSTGRES_CONN_ID=postgres_prontocardio
IPM_EXTRACTION_SCHEDULE=0 4 * * *
IPM_DOWNLOADS_DIR=/usr/local/airflow/data/ipm
IPM_TIMEOUT_SECONDS=60

# SPU Virtual Fortaleza
SPU_PORTAL_URL=https://spuvirtual.sepog.fortaleza.ce.gov.br
SPU_MATERIALIZER_URL=https://spumaterializar.sepog.fortaleza.ce.gov.br
SPU_LOGIN=LOGIN_DO_USUARIO
SPU_PASSWORD='SENHA_DO_PORTAL'
SPU_POSTGRES_CONN_ID=postgres_prontocardio
SPU_EXTRACTION_SCHEDULE=0 5 * * *
SPU_DOWNLOADS_DIR=/usr/local/airflow/data/spu
SPU_STORAGE_STATE_PATH=/usr/local/airflow/data/spu/auth_state.json
# Perfil isolado previamente autenticado; tem precedencia sobre auth_state.json
SPU_BROWSER_PROFILE_DIR=/usr/local/airflow/data/spu/browser_profile
SPU_BROWSER_HEADLESS=true
# Ao expirar, abre uma janela visivel, preenche as credenciais e aguarda o login
SPU_AUTO_RENEW_SESSION=true
SPU_AUTH_TIMEOUT_SECONDS=1800
# Desktop virtual protegido: porta disponível somente via túnel SSH
SPU_NOVNC_PASSWORD='ALTERE_PARA_UMA_SENHA_FORTE_DE_8_CARACTERES'
SPU_NOVNC_PORT=6080
SPU_NOVNC_SCREEN=1600x900x24
# Opcional; vazio usa o Chromium instalado pelo Playwright
SPU_BROWSER_EXECUTABLE_PATH=
SPU_PAGE_TIMEOUT_SECONDS=90
SPU_DOWNLOAD_DELAY_SECONDS=0.75
SPU_PROCESS_BATCH_SIZE=50
SPU_PDF_BATCH_SIZE=20

# Materialização das glosas após as extrações IPM/SPU
IPM_ORACLE_CONN_ID=oracle_prontocardio
AIRFLOW_CONN_ORACLE_PRONTOCARDIO=oracle://usuario:senha@host:1521/servico
ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_19_23
GLOSAS_IPM_DBT_PROJECT_DIR=/usr/local/airflow/dbt_glosas_ipm
